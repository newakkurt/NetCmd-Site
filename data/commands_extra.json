 {
  "slug": "ssh-etkinlestirme",
  "title": "SSH erişimini etkinleştirme",
  "cat": "Yönetim ve Erişim",
  "note": "Telnet şifresizdir; yönetim erişimi için SSH v2 kullan. Cisco'da RSA anahtarı için hostname ve domain-name gerekir; Huawei'de ayrıca 'ssh user <ad> authentication-type password' ve 'service-type stelnet' tanımlanır.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "ip domain-name lab.local",
    "crypto key generate rsa modulus 2048",
    "ip ssh version 2",
    "line vty 0 15",
    " transport input ssh",
    " login local"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "rsa local-key-pair create",
    "stelnet server enable",
    "user-interface vty 0 4",
    " authentication-mode aaa",
    " protocol inbound ssh"
   ]
  },
  "aruba": {
   "mode": "Global configuration",
   "cmds": [
    "ssh server vrf mgmt",
    "! AOS-S: ip ssh"
   ]
  }
 },
 {
  "slug": "yerel-kullanici",
  "title": "Yerel yönetici kullanıcı oluşturma",
  "cat": "Yönetim ve Erişim",
  "note": "TACACS+/RADIUS erişilemezse yerel kullanıcı son çare erişimidir; parolayı betikte düz metin tutma.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "username admin privilege 15 secret <parola>"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "aaa",
    " local-user admin password irreversible-cipher <parola>",
    " local-user admin privilege level 15",
    " local-user admin service-type ssh"
   ]
  },
  "aruba": {
   "mode": "Global configuration (AOS-CX)",
   "cmds": [
    "user admin group administrators password plaintext <parola>"
   ]
  }
 },
 {
  "slug": "tacacs-sunucusu",
  "title": "TACACS+ ile merkezi kimlik doğrulama",
  "cat": "Yönetim ve Erişim",
  "note": "Sunucu erişilemezse yerel kullanıcıya düşmek için 'local' yedeğini mutlaka ekle; aksi halde cihaza erişim kaybolabilir. Aruba AOS-CX söz dizimi sürüme göre değişir.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "aaa new-model",
    "tacacs server TAC1",
    " address ipv4 10.0.0.10",
    " key <anahtar>",
    "aaa authentication login default group tacacs+ local",
    "aaa authorization exec default group tacacs+ local"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "hwtacacs-server template TAC1",
    " hwtacacs-server authentication 10.0.0.10",
    " hwtacacs-server shared-key cipher <anahtar>",
    "aaa",
    " authentication-scheme TAC",
    "  authentication-mode hwtacacs local",
    " domain default_admin",
    "  authentication-scheme TAC",
    "  hwtacacs-server TAC1"
   ]
  },
  "aruba": {
   "mode": "Global configuration (AOS-CX)",
   "cmds": [
    "tacacs-server host 10.0.0.10 key plaintext <anahtar>",
    "aaa group server tacacs TAC",
    " server 10.0.0.10",
    "aaa authentication login default group TAC local"
   ]
  }
 },
 {
  "slug": "snmpv3",
  "title": "SNMPv3 kullanıcı ve grup tanımlama",
  "cat": "Yönetim ve Erişim",
  "note": "SNMPv3 kimlik doğrulama ve şifreleme sağlar; v2c topluluk dizeleri düz metin gider. Parolaları betiklerde saklama.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "snmp-server group NMS v3 priv",
    "snmp-server user monitor NMS v3 auth sha <auth-parola> priv aes 128 <priv-parola>"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "snmp-agent sys-info version v3",
    "snmp-agent group v3 NMS privacy",
    "snmp-agent usm-user v3 monitor group NMS authentication-mode sha cipher <auth-parola> privacy-mode aes128 cipher <priv-parola>"
   ]
  },
  "aruba": {
   "mode": "Global configuration (AOS-CX)",
   "cmds": [
    "snmpv3 user monitor auth sha auth-pass plaintext <auth-parola> priv aes priv-pass plaintext <priv-parola>"
   ]
  }
 },
 {
  "slug": "snmp-community",
  "title": "SNMP v2c topluluk (community) tanımlama",
  "cat": "Yönetim ve Erişim",
  "note": "v2c şifresizdir; mümkünse SNMPv3 kullan. Salt okunur topluluk kullan ve erişimi izleme sunucusuyla sınırla.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "snmp-server community <topluluk> RO"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "snmp-agent sys-info version v2c",
    "snmp-agent community read cipher <topluluk>"
   ]
  },
  "aruba": {
   "mode": "Global configuration",
   "cmds": [
    "snmp-server community <topluluk>",
    "! AOS-S: snmp-server community \"<topluluk>\" operator"
   ]
  }
 },
 {
  "slug": "snmp-trap",
  "title": "SNMP trap hedefi tanımlama",
  "cat": "Yönetim ve Erişim",
  "note": "Trap'ler olayları izleme sistemine anında iletir; sunucuda UDP 162'nin açık olduğundan emin ol.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "snmp-server host 10.0.0.5 version 2c <topluluk>",
    "snmp-server enable traps"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "snmp-agent target-host trap address udp-domain 10.0.0.5 params securityname <topluluk> v2c",
    "snmp-agent trap enable"
   ]
  },
  "aruba": {
   "mode": "Global configuration (AOS-CX)",
   "cmds": [
    "snmp-server host 10.0.0.5 trap version v2c community <topluluk>"
   ]
  }
 },
 {
  "slug": "vty-erisim-kisitlama",
  "title": "Yönetim erişimini ACL ile kısıtlama (VTY)",
  "cat": "Yönetim ve Erişim",
  "note": "Yönetim erişimi yalnızca yönetim ağından yapılabilmelidir; yanlış ACL kendi erişimini de keser, konsol yolunu hazır tut.",
  "cisco": {
   "mode": "Global configuration",
   "cmds": [
    "access-list 10 permit 10.99.0.0 0.0.0.255",
    "line vty 0 15",
    " access-class 10 in"
   ]
  },
  "huawei": {
   "mode": "System view",
   "cmds": [
    "acl number 2000",
    " rule 5 permit source 10.99.0.0 0.0.0.255",
    "user-interface vty 0 4",
    " acl 2000 inbound"
   ]
  },
  "aruba": {
   "mode": "Global configuration (AOS-S)",
   "cmds": [
    "ip authorized-managers 10.99.0.0 255.255.255.0 access manager"
   ]
  }
 },
